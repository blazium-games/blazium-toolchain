{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blazium Toolchain CDN manifest",
  "type": "object",
  "required": ["latest", "released_on", "versions"],
  "properties": {
    "latest": { "type": "string" },
    "released_on": { "type": "string", "format": "date-time" },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["released_on", "downloads"],
        "properties": {
          "released_on": { "type": "string", "format": "date-time" },
          "downloads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["platform", "arch", "filename", "download_url", "sha256", "size"],
              "properties": {
                "platform": { "type": "string" },
                "arch": { "type": "string" },
                "filename": { "type": "string" },
                "download_url": { "type": "string", "format": "uri" },
                "sig_url": { "type": "string", "format": "uri" },
                "sha256": { "type": "string" },
                "size": { "type": "integer", "minimum": 0 },
                "signing": { "type": "string", "enum": ["gpg", "sslcom", ""] }
              }
            }
          }
        }
      }
    }
  }
}
